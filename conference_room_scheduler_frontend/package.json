{
  "name": "conference-room-scheduler-frontend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "type-check": "tsc",
    "lint": "eslint . --config ./.eslintrc --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:c": "yarn run lint --format json --output-file coverage/eslint-report.json",
    "lint:fix": "eslint . --config ./.eslintrc --fix --ext .ts,.tsx",
    "format": "prettier . --config ./.prettierrc --check",
    "format:fix": "prettier . --config ./.prettierrc --write"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.1",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "^1.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.4",
    "react-redux": "^8.0.1",
    "react-router-dom": "^6.21.2",
    "reactstrap": "^9.2.1",
    "sweetalert2": "^11.10.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@testing-library/dom": "^9.2.0",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.2.5",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^21.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.2",
    "prettier-config-nick": "^1.0.2",
    "sass": "^1.69.7",
    "typescript": "*",
    "vite": "^4.0.0",
    "vitest": "^0.30.1",
    "workbox-window": "^7.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "react/jsx-no-target-blank": "off"
    }
  },
  "prettier": "prettier-config-nick",
  "lint-staged": {
    "**/*.(ts|tsx)": "yarn lint",
    "**/*.(md|json)": "yarn format"
  },
  "engines": {
    "node": ">=20.6.1",
    "yarn": ">=1.22.19",
    "npm": "please-use-yarn"
  },
  "packageManager": "yarn@1.22.19"
}
